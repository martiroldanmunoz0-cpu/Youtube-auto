          },
          {
            "pieza": "bacteria",
            "pos": "derecha",
            "tamano": "mediano",
            "anim": "crecer"
          }
        ],
        "label": "Rotting in weeks"
      },
      "camera": "push_in",
      "transition": "cut"
    },
    {
      "text": "But here's the good news. Canned food can last for years, often well past the printed date, as long as the can isn't damaged.",
      "scene": "composicion",
      "params": {
        "lugar": "fondo",
        "persona": "no",
        "piezas": [
          {
            "pieza": "vaso_agua",
            "pos": "centro",
            "tamano": "grande",
            "anim": "crecer"
          },
          {
