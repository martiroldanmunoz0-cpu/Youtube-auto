          }
        ],
        "label": "Perfect shelves"
      },
      "camera": "push_in",
      "transition": "fade"
    },
    {
      "text": "Reality: refrigeration stops within a day or two. Meat and dairy spoil first, and soon the whole building smells like something you'd never forget.",
      "scene": "composicion",
      "params": {
        "lugar": "cocina",
        "hora": "dia",
        "persona": "medio",
        "mood": "shocked",
        "piezas": [
          {
            "pieza": "hamburguesa",
            "pos": "izquierda",
            "tamano": "grande",
            "anim": "temblar"
          },
          {
            "pieza": "bacteria",
            "pos": "derecha",
            "tamano": "mediano",
            "anim": "crecer"
          }
        ],
        "label": "Fridges off. Meat spoils."
      },
      "camera": "shake",
      "transition": "red"
    },
    {
      "text": "Fresh fruit and vegetables rot within weeks. Bread grows mold. Flies arrive, then rats and insects, and the store becomes their kingdom.",
      "scene": "composicion",
      "params": {
        "lugar": "fondo",
        "persona": "no",
        "piezas": [
          {
            "pieza": "manzana",
            "pos": "centro",
            "tamano": "grande",
            "anim": "temblar"
          },
          {
            "pieza": "hormiga",
