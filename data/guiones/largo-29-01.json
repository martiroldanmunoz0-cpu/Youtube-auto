        "hora": "dia",
        "plano": "entero",
        "mood": "happy",
        "arms": "up",
        "label": "Empty Times Square"
      },
      "camera": "slam",
      "transition": "flash"
    },
    {
      "text": "Picture yourself alone in Times Square, spinning in the middle of the road with every billboard towering over you.",
      "scene": "composicion",
      "params": {
        "lugar": "ciudad",
        "hora": "dia",
        "persona": "entero",
        "mood": "happy",
        "piezas": [
          {
            "pieza": "edificio",
            "pos": "izquierda",
