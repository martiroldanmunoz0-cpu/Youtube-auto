      "params": {
        "lugar": "calle",
        "hora": "dia",
        "plano": "entero",
        "mood": "worried",
        "arms": "normal",
        "label": "Total silence"
      },
      "camera": "pan_left",
      "transition": "fade"
    },
    {
      "text": "Let's start with the fantasy every movie sells you first. The one about electricity. Myth number one.",
